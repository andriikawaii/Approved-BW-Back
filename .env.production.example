###############################################################################
# BuiltWell CT — Production Environment
# Copy to .env on production server and fill in real values.
###############################################################################

APP_NAME=BuiltWell
APP_ENV=production
APP_KEY=              # php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.builtwellct.com
FRONTEND_URL=https://builtwellct.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

###############################################################################
# Database
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=builtwell_backend
DB_USERNAME=              # secure user, NOT root
DB_PASSWORD=              # strong password

###############################################################################
# Session / Cache / Queue
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

###############################################################################
# Mail (transactional emails)
# Using Google Workspace SMTP — see notes:
#   - MAIL_USERNAME: the GWS user that will send mail (info@builtwellct.com)
#   - MAIL_PASSWORD: App Password generated at myaccount.google.com/apppasswords
#     (NOT the regular login password — 2FA must be on first)
#   - This user must exist in Google Workspace Admin Console
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@builtwellct.com
MAIL_PASSWORD=           # 16-char Google App Password (no spaces)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@builtwellct.com
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated recipients for new lead notifications
LEAD_RECIPIENTS=info@builtwellct.com,andrii@marketmovers.ai

###############################################################################
# Redis (optional — upgrade from database driver for better perf)
###############################################################################
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

###############################################################################
# Vite
###############################################################################
VITE_APP_NAME="${APP_NAME}"
